# Server-only. No key in this file may ever be shipped to the client (plan.md §14).
# Copy to .env and fill in.

PORT=8787

# Anthropic API — used by /api/claude (M3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Speech-to-text. MUST support word-level timestamps (plan.md §6.3).
# Reject any provider that does not.
#
#   vosk  — offline, local, free, no key. Native word timings. Needs the model:
#             npm run stt:model
#           Measured on a 2-core i3: 0.09x realtime, so a 3s utterance decodes
#           in ~0.3s. Requires ffmpeg on PATH to transcode the browser's
#           WebM/Opus to 16kHz mono PCM.
#   mock  — scripted transcript with synthesised word timings, no key. A test
#           double for developing the upload path, not a fallback.
#             curl -X POST localhost:8787/api/stt/mock \
#               -H 'content-type: application/json' -d '{"text":"put a cube here"}'
STT_PROVIDER=
STT_API_KEY=

# Override the Vosk model location. Relative paths resolve from the repo root.
# Defaults to server/models/vosk-model-small-en-us-0.15 (gitignored, 68MB).
# Swapping in a larger model is a path change and nothing else.
VOSK_MODEL_PATH=

# Where scene documents and event logs are written (M6).
# Relative paths resolve from the repo root. Defaults to server/data.
DATA_DIR=./server/data

# Parametric props (plan.md §2, amended). The generator library is fetched from
# here and its code is evaluated on the server, so point it at a build you
# control. Leave it unset to use only the snapshot bundled in the repo.
STUDIO_URL=https://jasonsperske.github.io/object_studio/
