# Server-only. No key in this file may ever be shipped to the client (plan.md §14).
# Copy to .env and fill in.

PORT=8787

# Anthropic API — used by /api/claude (M3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Speech-to-text. MUST support word-level timestamps (plan.md §6.3).
# Reject any provider that does not.
#
# STT_PROVIDER=mock serves a scripted transcript with synthesised word timings
# and needs no key. It is a test double for developing the M1 upload path, not
# a fallback — see server/src/stt/mock.ts.
#   curl -X POST localhost:8787/api/stt/mock -H 'content-type: application/json' \
#        -d '{"text":"put a cube here"}'
STT_PROVIDER=
STT_API_KEY=

# Where scene documents and event logs are written (M6).
# Relative paths resolve from the repo root. Defaults to server/data.
DATA_DIR=./server/data
